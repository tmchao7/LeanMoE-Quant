# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# Virtualenv
.venv/
.venv-mac/
venv/

# Experiment outputs: raw data stays local; stable records get excerpted into commits
results/*
!results/.gitkeep

# Model caches / weights — never commit
models/
*.safetensors
*.bin
*.gguf
.cache/
hf_cache/

# ★ Credentials — NEVER commit. Only the .example template is tracked.
.env
.env.*
!.env.example
*.env
!configs/env.env.example
auth.json
*credentials*.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
