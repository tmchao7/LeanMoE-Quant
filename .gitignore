# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# Virtualenv
.venv/
.venv-mac/
venv/
# `uv run` 会生成锁文件，但**不是**本项目的 pinning 机制：pin 在
# configs/constraints.txt，而且是**按机器**冻结的（AGENTS.md「Environment」）。
# 一个由 Mac 解析出来的 lock 会谎报服务器环境（torch 2.8.0+cu128 / miniconda），
# 所以不提交它。
uv.lock

# Experiment outputs: raw data stays local; stable records get excerpted into commits
results/*
!results/.gitkeep

# Model caches / weights — never commit
models/
*.safetensors
*.bin
*.gguf
.cache/
hf_cache/

# ★ Credentials — NEVER commit. Only the .example template is tracked.
.env
.env.*
!.env.example
*.env
!configs/env.env.example
auth.json
*credentials*.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# WorkBuddy 残余（已弃用，防复发）
.workbuddy/
.zcode/

# 本地保留的项目亮点素材（不入库；用户后续自行整理进作品集）
HIGHLIGHTS.md

# 本地保留（不入库）：流程/投递/交接文档与 agent 配置——GitHub 只留 README+RESULTS+代码+记录+技术参考
AGENTS.md
PLAN.md
ENVIRONMENT.md
opencode.json
